{
  "version": 1,
  "status": "frozen-current-state",
  "publicSeams": [
    "desktop-control-plane",
    "server-http-sse",
    "agent-shim",
    "computer-engine-process"
  ],
  "currentInterfaces": {
    "desktopControlTransport": "Unix socket JSON ControlRequest/ControlResponse",
    "agentCommandTransport": "HTTP POST /runtime/cli with raw argv",
    "controlCommands": [
      "status",
      "ensure_local_computer",
      "list_agents",
      "list_rooms",
      "create_agent",
      "set_agent_proactivity",
      "create_direct_room",
      "create_group_room",
      "list_room_members",
      "add_group_member",
      "remove_group_member",
      "send_message",
      "list_messages",
      "list_boards",
      "create_board",
      "list_runs",
      "shutdown_server"
    ],
    "agentCommands": [
      "inbox",
      "glance",
      "reply",
      "ack",
      "dm",
      "react",
      "group create",
      "group invite",
      "group leave",
      "group kick",
      "card list",
      "card create",
      "card claim",
      "card move"
    ],
    "httpRoutes": [
      "GET /health",
      "POST /api/computers/me/start",
      "POST /api/computers/me/heartbeat",
      "GET /api/computers/me/agents",
      "POST /api/computers/me/agents/{agent_id}/token",
      "GET /runtime/wake-stream",
      "GET /runtime/inbox",
      "GET /runtime/inbox-triage/payload",
      "POST /runtime/triage",
      "GET /runtime/agenda/payload",
      "POST /runtime/agenda/decision",
      "POST /runtime/runs",
      "POST /runtime/cli",
      "POST /runtime/runs/{run_id}/heartbeat",
      "POST /runtime/runs/{run_id}/finish"
    ],
    "sseRoutes": [
      "GET /runtime/wake-stream"
    ],
    "desktopBehavior": [
      "Desktop installs and reconciles Server and Computer launchd jobs",
      "launchd keeps Server and Computer alive after Desktop exits",
      "Desktop does not yet own or stop the child-process group"
    ]
  },
  "behaviorCoverage": [
    {
      "behavior": "agent-creation",
      "testFile": "tests/p0_server.rs",
      "testName": "user_control_creates_a_group_and_manages_agent_members"
    },
    {
      "behavior": "room-message-and-inbox-settlement",
      "testFile": "tests/p0_server.rs",
      "testName": "runtime_opens_a_delivery_publishes_a_reply_and_settles_the_message"
    },
    {
      "behavior": "held-reply",
      "testFile": "tests/p2_collaboration.rs",
      "testName": "stale_group_reply_is_held_until_the_agent_reconsiders_once"
    },
    {
      "behavior": "card-claim-and-agenda-focus",
      "testFile": "tests/p3_agenda.rs",
      "testName": "p3_card_claim_has_one_winner_and_agenda_run_keeps_a_focus"
    },
    {
      "behavior": "computer-opencode-shim-round-trip",
      "testFile": "tests/p0_daemon_e2e.rs",
      "testName": "computer_daemon_drives_opencode_through_the_shim_to_a_settled_reply"
    },
    {
      "behavior": "current-server-shutdown-handoff",
      "testFile": "tests/p0_server.rs",
      "testName": "owner_control_stops_the_server_for_a_launchd_handoff"
    },
    {
      "behavior": "current-desktop-startup-handoff-decision",
      "testFile": "../../desktop/src-tauri/src/collab_client.rs",
      "testName": "old_control_contract_requires_handoff_even_when_the_plist_is_unchanged"
    },
    {
      "behavior": "current-launchd-unload-wait",
      "testFile": "src/launchd.rs",
      "testName": "unload_waits_until_launchd_finishes_async_cleanup"
    }
  ],
  "reset": {
    "dryRunOnly": true,
    "postgresTables": [
      "collab_schema_migrations",
      "collab_participants",
      "collab_computers",
      "collab_computer_engines",
      "collab_agents",
      "collab_rooms",
      "collab_room_members",
      "collab_messages",
      "collab_runs",
      "collab_run_deliveries",
      "collab_triages",
      "collab_events",
      "collab_cli_requests",
      "collab_reactions",
      "collab_boards",
      "collab_board_columns",
      "collab_cards"
    ],
    "redisNamespaces": [
      "openwork:message.new",
      "openwork:wake:",
      "openwork:wake-claim:",
      "openwork:turn-rate:",
      "openwork:seen:",
      "openwork:agenda-declines:",
      "openwork:agenda-rate:",
      "openwork:agenda-nudge:",
      "openwork:hold:"
    ],
    "filesystem": {
      "preserve": [
        "~/.openwork/agents/*/work/**",
        "~/.openwork/computer/agents/*/workspace/**"
      ],
      "reviewBeforeDelete": [
        "~/.openwork/computer/agents/*/memory/**",
        "~/.openwork/computer/agents/*/notes/**",
        "~/.openwork/computer/sessions/*.session"
      ],
      "regenerate": [
        "~/.openwork/server/control.sock",
        "~/.openwork/server/runtime-signing.key",
        "~/.openwork/computer/computer.json",
        "~/.openwork/computer/agents/*/AGENTS.md",
        "~/.openwork/computer/agents/*/.openwork-standing-prompt.md",
        "~/.openwork/computer/agents/*/bin/.runtime-token",
        "~/.openwork/computer/agents/*/bin/openwork",
        "~/.openwork/computer/opencode-config/**",
        "~/.openwork/computer/triage/**",
        "~/.openwork/logs/**"
      ],
      "retireAfterCutover": [
        "~/Library/LaunchAgents/io.openwork.collab.server.plist",
        "~/Library/LaunchAgents/io.openwork.collab.computer.plist",
        "~/.openwork/computer/computer.json",
        "~/.openwork/server/control.sock"
      ]
    }
  }
}
