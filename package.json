{
  "name": "crew",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @crew/desktop dev",
    "lint": "biome check --error-on-warnings . && tsx scripts/verify-docs.ts && tsx scripts/verify-code.ts",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "pnpm -r test && vitest run scripts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:smoke",
    "test:smoke": "pnpm --filter @crew/desktop test:smoke",
    "test:e2e": "pnpm --filter @crew/desktop test:e2e",
    "preview:shot": "pnpm --filter @crew/desktop preview:shot"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "lefthook": "^2.1.16",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
